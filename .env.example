NEXT_PUBLIC_MAX_UPLOAD_SIZE="1024" # Maximum total upload size in MB
NEXT_PUBLIC_MAX_UPLOAD_FILES="10" # Maximum number of files per upload
NEXT_PUBLIC_UPLOAD_EXPIRE_OPTIONS="[24,12,6,3,1]" # JSON array of allowed upload expire options (in hours)
NEXT_PUBLIC_UPLOAD_MAX_DOWNLOAD_OPTIONS="[10,5,3,1]" # JSON array of allowed maximum download options
NEXT_PUBLIC_SHOW_FAQ="true" # Show frequently asked questions on home page
NEXT_PUBLIC_SHOW_DOWNLOAD_WARNING="true" # Show a safety warning before download (recommended)
NEXT_PUBLIC_ORGANIZATION_NAME="Your Company, Inc." # Displayed in footer, terms of service, privacy policy
NEXT_PUBLIC_ORGANIZATION_CONTACT="contact@your-company.example" # Displayed in terms of service, privacy policy

DATABASE_URL="" # Postgres connection string (local Postgres, Neon, Supabase, Vercel Postgres, etc.)
CRON_SECRET="" # Bearer token for /api/cron/cleanup

S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET="your-s3-bucket-name"
S3_PREFIX="/" # Prefix (folder): This is where your lifecycle policy should be applied
S3_KEY_ID=""
S3_SECRET_KEY=""
S3_URL_EXPIRE_TIME="900"
